# ==============================================================================
# FRIEREN DISCORD LOGBOOK AUTOMATION - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: Never commit your real private .env file to public Git repositories!
# Copy this file to .env and fill in real private credentials on your server host.
# ==============================================================================

# Discord Gateway Credentials
# Obtained from Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your-discord-bot-token-here
DISCORD_APPLICATION_ID=your-discord-application-id-here
PLATFORM_ADMIN_DISCORD_IDS=your-admin-discord-user-id

# Relational Database & Encryption at Rest
# Postgres URL in production (or sqlite in development)
DATABASE_URL=postgres://frieren:replace-me@postgres:5432/frieren_logbook
# 32-byte or long random secret used for AES-256-GCM encryption of credentials
DATABASE_ENCRYPTION_KEY=replace-with-a-random-32-byte-hex-or-phrase
SESSION_SIGNING_KEY=replace-with-another-secure-random-phrase

# Admin Dashboard Authentication (Single Platform Admin)
# NOTE: The server operator has explicitly selected:
#   ADMIN_DASH_USERNAME=atmin
#   ADMIN_DASH_PASSWORD=password123
# Set these values in your real private host .env file.
ADMIN_DASH_USERNAME=atmin
ADMIN_DASH_PASSWORD=replace-with-your-private-admin-password
ADMIN_DASH_SESSION_TTL_MINUTES=60

# Ingress & Tailscale Funnel
# Existing Tailscale Funnel exposes local loopback port to public internet.
ADMIN_BIND_HOST=127.0.0.1
ADMIN_BIND_PORT=3100
# Public HTTPS URL configured on your Tailscale Funnel or reverse proxy
AGENT_API_PUBLIC_BASE_URL=https://your-server.tailscale-funnel-domain.ts.net

# Gemini AI Key Failover Pool
# Keys are attempted in order (1 -> 2 -> ... -> user personal key on retryable error)
GEMINI_API_KEY_1=replace-with-primary-gemini-key
GEMINI_API_KEY_2=replace-with-secondary-gemini-key
GEMINI_MODEL=gemini-3.8-flash

# Default Schedule Preferences (Asia/Jakarta)
DEFAULT_TIMEZONE=Asia/Jakarta
DEFAULT_REMINDER_TIME=16:00
DEFAULT_WORK_START=07:10
DEFAULT_WORK_END=16:25
REVIEW_WINDOW_MINUTES=15
SCREENSHOT_RETENTION_DAYS=30

# DERMAGA Portal Endpoints
DERMAGA_LOGIN_URL=https://jti.polinema.ac.id/dermaga/login
DERMAGA_MONITORING_URL=https://jti.polinema.ac.id/dermaga/mahasiswa/monitoring
DERMAGA_SUBMIT_URL=https://jti.polinema.ac.id/dermaga/mahasiswa/monitoring/simpan
