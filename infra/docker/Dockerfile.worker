FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for Chromium / Playwright
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    gnupg \
    ca-certificates \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir beautifulsoup4 pillow requests playwright \
    && playwright install chromium

COPY services/dermaga-worker/ ./services/dermaga-worker/
COPY tests/fixtures/ ./tests/fixtures/

RUN mkdir -p data/evidence

CMD ["python3", "services/dermaga-worker/playwright_verifier.py"]
